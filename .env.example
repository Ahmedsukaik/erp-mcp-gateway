# --- The ERP the gateway talks to -------------------------------------------
ERP_URL=http://127.0.0.1:8100
ERP_READ_KEY=change-me-erp-read-key
ERP_WRITE_KEY=change-me-erp-write-key
ERP_CURRENCY=GBP
ERP_DB=erp.db

# --- The gateway -------------------------------------------------------------
GATEWAY_DB=gateway.db
# One token per agent or person. Roles: reader, agent, approver.
# Generate real tokens with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKENS='{"change-me-reader-token-000000": {"name": "reporting-bot", "role": "reader"}, "change-me-agent-token-0000000": {"name": "order-intake-agent", "role": "agent"}, "change-me-approver-token-00000": {"name": "sara", "role": "approver"}}'

# --- Used by the command-line tools (approver CLI and the agent) ---------------
GATEWAY_URL=http://127.0.0.1:8101
GATEWAY_APPROVER_TOKEN=change-me-approver-token-00000
GATEWAY_AGENT_TOKEN=change-me-agent-token-0000000

